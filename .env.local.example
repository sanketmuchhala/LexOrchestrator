# LexOrchestrator - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ─── Supabase (required for persistence and vector search) ───────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── LLM Provider (pick one) ─────────────────────────────────────────────────
#
# OPTION A — OpenRouter (recommended)
# Get your key at openrouter.ai/keys
# Gives access to 200+ models (GPT-4o, Claude, Gemini, Llama, Mistral, etc.)
# with a single API key and automatic failover.
OPENROUTER_API_KEY=sk-or-v1-...

# OPTION B — OpenAI directly
# Only used if OPENROUTER_API_KEY is not set.
OPENAI_API_KEY=sk-...

# ─── Model selection ─────────────────────────────────────────────────────────
# OpenRouter format:  "openai/gpt-4o-mini", "anthropic/claude-3-haiku", etc.
# OpenAI format:      "gpt-4o-mini", "gpt-4o"
# Default is auto-detected based on which key is present.
LLM_MODEL=openai/gpt-4o-mini

# Embedding model (must be 1536-dim to match pgvector column).
# OpenRouter format:  "openai/text-embedding-3-small"
# OpenAI format:      "text-embedding-3-small"
EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Setup sequence ──────────────────────────────────────────────────────────
# 1. Create a Supabase project at supabase.com
# 2. Run supabase/migrations/003_schema_redesign.sql in SQL Editor
# 3. npm run seed:legal          (seeds 12 sample corpus chunks)
# 4. npm run seed:constitution   (seeds US Constitution as primary RAG source)
# 5. npm run embed:legal         (generates pgvector embeddings - requires API key)
# 6. npm run dev

# ─── Fallback behavior ───────────────────────────────────────────────────────
# - No SUPABASE_*:              app runs with in-memory corpus, persisted: false
# - No OPENROUTER/OPENAI key:   agents use deterministic outputs, hash-based embeddings
