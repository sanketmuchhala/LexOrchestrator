# LexOrchestrator - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ─── Supabase (required for persistence and vector search) ───────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OpenAI (optional - app works without it using deterministic fallback) ────
# Required for: real LLM agent responses, real embeddings (hybrid RAG)
OPENAI_API_KEY=sk-...

# LLM model for agent calls (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Embedding model for pgvector search (default: text-embedding-3-small, 1536 dims)
EMBEDDING_MODEL=text-embedding-3-small

# ─── Setup sequence ──────────────────────────────────────────────────────────
# 1. Create a Supabase project at supabase.com
# 2. Paste supabase/migrations/001_lexorchestrator_phase1.sql into SQL Editor
# 3. Paste supabase/migrations/002_hybrid_rag_pgvector.sql into SQL Editor
# 4. npm run seed:legal          (seeds 12 sample corpus chunks)
# 5. npm run seed:constitution   (seeds US Constitution as primary RAG source)
# 6. npm run embed:legal         (generates pgvector embeddings - requires OPENAI_API_KEY)
# 7. npm run dev

# ─── Fallback behavior ───────────────────────────────────────────────────────
# - No SUPABASE_*:    app runs with in-memory corpus, persisted: false
# - No OPENAI_API_KEY: agents use deterministic outputs, hash-based embeddings
