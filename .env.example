# LexOrchestrator -- Environment Variables
# Copy to .env.local and fill in your values.
# Never commit .env.local or .env to git.
#
# The app runs in fallback/demo mode without any vars set:
#   - No Supabase: workflow runs are ephemeral (not persisted)
#   - No LLM key: agents use deterministic outputs
#   - No citation worker: regex extractor is used instead

# ── Supabase (optional -- required for persistence) ───────────────────────────
# Get from: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── LLM Provider (optional -- pick one) ───────────────────────────────────────
# OpenRouter is recommended (access to 200+ models via one key).
# Only one is needed. If both are set, OPENROUTER_API_KEY takes priority.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Citation Worker (optional) ────────────────────────────────────────────────
# URL of the Python eyecite worker (Phase 15).
# Leave blank to use the built-in regex citation extractor.
CITATION_WORKER_URL=

# ── App URL (recommended in production) ───────────────────────────────────────
# Set this on Vercel or your deployment platform.
# Example: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
